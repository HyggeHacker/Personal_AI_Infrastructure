# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
Library

# Environment files
.env
.env.local
.env.*.local
*.env

# API keys and secrets
*.pem
*.key
*.cert
*.p12
*.pfx
*_rsa
*_rsa.pub
*.crt
*.cer

# Logs
*.log
logs/
Library/Logs/

# Node/Bun
node_modules/
.npm
.yarn
.pnp.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp

# Build outputs
dist/
build/
out/

# Re-include Pulse Observability built dashboard — must ship in public releases
# so fresh installs get a working dashboard immediately. The `out/` rule above
# is correct for repo-root build artifacts; this re-include scopes only to the
# release directories.
!Releases/*/.claude/PAI/PULSE/Observability/out/
!Releases/*/.claude/PAI/PULSE/Observability/out/**

# Cache
.cache/
*.cache

# Personal/Private data
private/
secrets/
credentials/

# PAI Update System (sideloading)
.claude/pai_updates/
.claude/pai_backups/
.claude/.pai-sync-history

# per-machine release marker (read by pai-sync; never commit)
.pai-release

# Skill runtime outputs — public skills are symlinked live<->fork, so anything a
# skill writes into its own dir at runtime lands in this working tree. Keep pure
# runtime state out of git; `LinkSkills.sh --check` surfaces any other dirt to triage.
LifeOS/install/skills/Evals/Results/
LifeOS/install/skills/*/Downloads/
LifeOS/install/skills/Daemon/**/daemon-data.json
LifeOS/install/skills/*/Logs/*.jsonl
!LifeOS/install/skills/Upgrade/Logs/run-history.jsonl
# Currency runtime state (regenerated per check; never a durable input)
LifeOS/install/skills/*/State/
LifeOS/install/skills/*/*/State/
