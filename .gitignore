*.tmp

# Build outputs
dist/
build/
out/

# ...except the Pulse dashboard's static export, which is a SHIPPED release
# artifact, not a local build artifact. A fresh install must get a working
# dashboard at localhost:31337 with no build step. The bare `out/` above silently
# swallowed it for every release after the payload moved to LifeOS/install/ —
# `git add -A LifeOS/` honors .gitignore, so 181 files were dropped at publish
# while every release gate passed against the staging tree where they existed.
# Order matters: git cannot re-include a file whose parent directory is excluded,
# so the directory is un-ignored first, then its contents.
!LifeOS/install/LIFEOS/PULSE/Observability/out/
!LifeOS/install/LIFEOS/PULSE/Observability/out/**

# Cache
.cache/
*.cache

# Personal/Private data
private/
secrets/
credentials/

# PAI Update System (sideloading)
.claude/pai_updates/
.claude/pai_backups/
.claude/.pai-sync-history

# Private skill packs — client-adjacent pentest tooling.
# This repo is PUBLIC; these must never be committed. Symlinked into
# ~/.claude/skills/_* at runtime. (2026-07-28)
Private-Packs/

# Retired upstream release snapshots. The v7 rebuild dropped Releases/ from this
# fork, but the directory still lingers on disk and upstream still ships it — so
# an upstream merge would try to re-add ~10k files. (2026-08-17 divergence analysis)
Releases/

# Local runtime artifacts. These existed as ignore rules pre-v7 and were lost in the
# v7 rebuild, so `git add -A` silently stages them. Currency state is regenerated per
# check and is never a durable input; .pai-release is a local install marker that goes
# stale against the tree it sits in. (restored 2026-08-25)
.pai-release
LifeOS/install/skills/*/State/
LifeOS/install/skills/*/*/State/
LifeOS/install/skills/*/Logs/*.jsonl
